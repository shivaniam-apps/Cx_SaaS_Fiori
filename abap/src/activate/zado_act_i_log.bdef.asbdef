managed implementation in class zbp_ado_act_i_log unique;

define behavior for ZADO_ACT_I_LOG //alias Log
persistent table zado_act_log
lock master
authorization master ( instance )
{
  field ( readonly ) LogUuid;

  " Static action: no instance persistence - the log table exists only to
  " make the entity a valid RAP BO root. The handler calls the RFC wrapper
  " via DESTINATION 'NONE'.
  static action executeStep parameter ZADO_A_ACT_INPUT result [1] ZADO_A_ACT_RESULT;

  mapping for zado_act_log
  {
    LogUuid   = log_uuid;
    StepType  = step_type;
    Status    = status;
    CreatedAt = created_at;
  }
}
