_schema-version: '3.2'
ID: adops-basic.prod
extends: adops-basic
version: 0.1.0

# Production space. Deploy blue-green with a testing phase (T5):
#   cf deploy mta_archives/adops-basic_<version>.mtar -e mtaext/prod.mtaext --strategy blue-green
#   ... verify /readyz and the approuter on the idle (blue/green) routes ...
#   cf deploy -i <operation id> -a resume        (or -a abort)
# The archive is the one built by the Release workflow for the tag; the
# release checklist is docu/05-deployment-tiers/release-process.md.
# See docu/05-deployment-tiers/environments.md.

modules:
  - name: adops-basic
    parameters:
      memory: 256MB

  - name: adops-basic-srv
    parameters:
      # Two instances: the task runner claims work atomically and the audit
      # chain locks its per-tenant head row, so instances do not conflict.
      instances: 2
      memory: 1024MB
    properties:
      CORS_ORIGINS: ~{adops-basic-router-api/app-url}
      ADOPTOPS_TASK_CONCURRENCY: 2
      ADOPTOPS_TELEMETRY_CLEANUP_INTERVAL_HOURS: 12

resources:
  - name: adops-basic-postgres
    parameters:
      service-plan: standard
  - name: adops-basic-cloud-logging
    parameters:
      service-plan: standard
